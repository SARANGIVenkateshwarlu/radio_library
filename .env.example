# Copy this file to `.env` and fill in your own key. `.env` is git-ignored.
#
# ============================ LLM (translation / correction) ================
# Any OpenAI-compatible endpoint works — cloud or local.
#
# xAI / Grok (cloud)
OPENAI_BASE_URL=https://api.x.ai/v1
OPENAI_API_KEY=xai-your-key-here
LLM_MODEL=grok-4.20-0309-non-reasoning
# Parallel LLM requests per stage (lower if you hit rate limits)
LLM_MAX_WORKERS=4
#
# Local Ollama (no cloud key; run `ollama serve` first):
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_API_KEY=ollama
#   LLM_MODEL=qwen2.5:14b            # good Chinese/English, fast on a GPU/CPU
#   LLM_MAX_WORKERS=2
# Other OpenAI-compatible providers: OpenAI, OpenRouter, Groq, DeepSeek ...

# ============================ ASR (Cantonese speech) =======================
# Backend: "faster-whisper" (CTranslate2, fastest) or "transformers".
WHISPER_BACKEND=faster-whisper
# Model id or local path.
#   Recommended (Cantonese large-v3-turbo, converted to CTranslate2):
#     WHISPER_MODEL=models/whisper-large-v3-turbo-cantonese-ct2
#   Or a transformers model directly (slower):
#     WHISPER_BACKEND=transformers
#     WHISPER_MODEL=wingskh/whisper-large-v3-turbo-cantonese
#   Quick test only: WHISPER_MODEL=base   (weak Cantonese — not for real use)
#   Accuracy + speed:
#     GPU  : khleeloo/whisper-large-v3-cantonese -> ct2, DEVICE=cuda, COMPUTE=float16, BATCH=16
#     CPU  : wingskh/whisper-large-v3-turbo-cantonese -> ct2, DEVICE=cpu, COMPUTE=int8, BATCH=8
WHISPER_MODEL=models/whisper-large-v3-turbo-cantonese-ct2
WHISPER_DEVICE=cpu            # or cuda
WHISPER_COMPUTE=int8          # int8 (cpu) / float16 (gpu)
WHISPER_LANGUAGE=yue          # Cantonese; "" = auto-detect
WHISPER_BEAM=5                # 1-2 faster, 5 more accurate
WHISPER_BATCH_SIZE=8          # >1 = batched inference (big speed-up); 16-32 on GPU
WHISPER_INITIAL_PROMPT=以下係香港廣東話電台節目嘅內容，請用繁體中文轉寫。

# Quality review: re-run flagged segments until this score (0-100), max attempts
QREVIEW_TARGET=90
QREVIEW_MAX_ATTEMPTS=2

# Optional: only needed if `ffmpeg` is not on your PATH. Point it at ffmpeg.exe.
# FFMPEG_BINARY=C:\Users\you\AppData\Local\Microsoft\WinGet\Packages\Gyan.FFmpeg_...\bin\ffmpeg.exe
