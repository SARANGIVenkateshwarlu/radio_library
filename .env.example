# Copy this file to `.env` and fill in your own key. `.env` is git-ignored.
#
# xAI / Grok (OpenAI-compatible endpoint)
OPENAI_BASE_URL=https://api.x.ai/v1
OPENAI_API_KEY=xai-your-key-here
LLM_MODEL=grok-4.20-0309-non-reasoning
# Parallel LLM requests per stage (lower if you hit rate limits)
LLM_MAX_WORKERS=4

# Any other OpenAI-compatible provider works too — just change base URL/model:
#   OpenAI      OPENAI_BASE_URL=https://api.openai.com/v1        LLM_MODEL=gpt-4o-mini
#   OpenRouter  OPENAI_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=...
#   Groq        OPENAI_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=...
#   DeepSeek    OPENAI_BASE_URL=https://api.deepseek.com         LLM_MODEL=deepseek-chat
#   Ollama      OPENAI_BASE_URL=http://localhost:11434/v1        LLM_MODEL=llama3.1

# Optional: only needed if `ffmpeg` is not on your PATH. Point it at ffmpeg.exe.
# FFMPEG_BINARY=C:\Users\you\AppData\Local\Microsoft\WinGet\Packages\Gyan.FFmpeg_...\bin\ffmpeg.exe
