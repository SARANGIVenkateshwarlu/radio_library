        {"chinese": "八達通", "jyutping": "baat3 daat6 tung1", "english": "Octopus card"},
        {"chinese": "或者", "jyutping": "waak6 ze2", "english": "or"},
        {"chinese": "信用卡", "jyutping": "seon3 jung6 kaat1", "english": "credit card"},
        {"chinese": "俾錢", "jyutping": "bei2 cin2", "english": "to pay"}
      ]
    },
