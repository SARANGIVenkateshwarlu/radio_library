        {"chinese": "落單", "jyutping": "lok6 daan1", "english": "place an order"}
      ]
    },
    {
      "cantonese": "你先排隊，我去睇下個餐牌。",
      "jyutping": "nei5 sin1 paai4 deoi2, ngo5 heoi3 tai2 haa6 go3 caan1 paai2.",
      "english": "You queue up first — I'll go have a look at the menu.",
      "segments": [
        {"chinese": "你", "jyutping": "nei5", "english": "you"},
        {"chinese": "先", "jyutping": "sin1", "english": "first"},
        {"chinese": "排隊", "jyutping": "paai4 deoi2", "english": "queue up"},
