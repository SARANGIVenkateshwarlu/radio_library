        {"chinese": "睇下", "jyutping": "tai2 haa6", "english": "have a look at"},
        {"chinese": "個餐牌", "jyutping": "go3 caan1 paai2", "english": "the menu"}
      ]
    },
    {
      "cantonese": "我想食個牛肉飯同埋一杯凍檸茶。",
      "jyutping": "ngo5 soeng2 sik6 go3 ngau4 juk6 faan6 tung4 maai4 jat1 bui1 dung3 ning4 caa4.",
      "english": "I want a beef rice and an iced lemon tea.",
      "segments": [
        {"chinese": "我想食", "jyutping": "ngo5 soeng2 sik6", "english": "I want to eat"},
        {"chinese": "個牛肉飯", "jyutping": "go3 ngau4 juk6 faan6", "english": "a beef rice"},
        {"chinese": "同埋", "jyutping": "tung4 maai4", "english": "and also"},
