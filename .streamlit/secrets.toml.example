# Copy this file to `.streamlit/secrets.toml` and fill in your own key.
# `.streamlit/secrets.toml` is git-ignored; this example is safe to commit.
#
# Streamlit reads this automatically when you run:
#   streamlit run streamlit_app.py

OPENAI_BASE_URL = "https://api.x.ai/v1"
OPENAI_API_KEY = "xai-your-key-here"
LLM_MODEL = "grok-4.20-0309-non-reasoning"
LLM_MAX_WORKERS = "4"
